{
  "manifest_version": 3,
  "name": "CAIOS Chrome Extension",
  "version": "0.5.0.3",
  "description": "Connect CAIOS to Chrome tabs you choose, helping it read pages, navigate websites and fill forms during approved tasks.",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "CAIOS Chrome Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "version_name": "0.5.0-CAIOS.3"
}
